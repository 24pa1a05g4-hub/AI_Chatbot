
import React, { useState } from 'react';

function App() {
  const [count, setCount] = useState(0);

  return (
    <div>
      <h1>Count: {count}</h1>

      <button onClick={() => setCount(count + 1)}>
        Increase
      </button>

      <Child name="Monika" />
    </div>
  );
}

function Child(props) {
  return <h2>Hello {props.name}</h2>;
}

export default App;

