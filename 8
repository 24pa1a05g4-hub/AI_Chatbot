
function App() {
  const fruits = ["Apple", "Mango", "Orange"];

  return (
    <div>
      <h1>Fruit List</h1>

      <ul>
        {fruits.map((item, index) => (
          <li key={index}>{item}</li>
        ))}
      </ul>
    </div>
  );
}

export default App;

